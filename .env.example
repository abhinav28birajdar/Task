
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# GOOGLE SIGN-IN CONFIGURATION (Required for Google login)
# Get from: https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CLIENT_TOKEN=your-facebook-client-token

# -----------------------------------------------------------------------------
# FIREBASE CONFIGURATION (Required for push notifications)
# Get from: https://console.firebase.google.com/
# -----------------------------------------------------------------------------
# Firebase configuration is handled by:
# - android/app/google-services.json (for Android)
# - ios/Runner/GoogleService-Info.plist (for iOS)
# - lib/firebase_options.dart (generated by FlutterFire CLI)

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
# Enable/disable cloud sync (set to 'false' for offline-only mode)
ENABLE_CLOUD_SYNC=true

# Enable/disable debug mode
DEBUG_MODE=false

# Hive box names (local storage)
HIVE_BOX_NAME=todos
CATEGORIES_BOX_NAME=categories
NOTES_BOX_NAME=notes
SETTINGS_BOX_NAME=settings

# -----------------------------------------------------------------------------
# OPTIONAL: AI ASSISTANT CONFIGURATION
# For AI-powered task suggestions (future feature)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=your-openai-api-key
# AI_MODEL=gpt-4
